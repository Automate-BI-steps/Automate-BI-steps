{
  "kpis": [
    {
      "id": "total_imports",
      "name": "Total Imports",
      "definition": "Sum of trade value for import transactions",
      "expression": "SUM(value) where direction=Import",
      "source_columns": ["value", "direction"],
      "supported": true
    },
    {
      "id": "total_exports",
      "name": "Total Exports",
      "definition": "Sum of trade value for export transactions",
      "expression": "SUM(value) where direction=Export",
      "source_columns": ["value", "direction"],
      "supported": true
    },
    {
      "id": "trade_balance",
      "name": "Trade Balance",
      "definition": "Total exports minus total imports",
      "expression": "[Total Exports] - [Total Imports]",
      "source_columns": ["value", "direction"],
      "supported": true
    },
    {
      "id": "transaction_count",
      "name": "Transaction Count",
      "definition": "Number of trade transactions",
      "expression": "COUNTROWS(FactTrade)",
      "source_columns": [],
      "supported": true
    }
  ]
}
