# Copier ce fichier en .env, puis renseigner les clés Groq (une par agent).
# Les commentaires restent sur leurs propres lignes : le chargeur de .env ne retire pas ceux placés après une valeur.
# Ne laisser aucun texte d'exemple dans une clé : il serait envoyé au fournisseur comme une vraie clé.

# =====================================================================================================
# Une clé LLM PAR AGENT, pour ne pas vider une seule clé API (voir src/llm_keys.py).
# Chaque agent lit sa clé propre ; si elle est vide, il utilise la clé partagée GROQ_API_KEY ;
# sans aucune clé il travaille avec ses règles. Une clé vide compte comme absente.
#
# Attention : chez Groq, les limites de débit s'appliquent à l'organisation (le compte), pas à chaque clé.
# Plusieurs clés du même compte partagent donc le même quota. Pour répartir la charge, créez les clés dans des
# comptes différents, ou donnez un modèle différent à chaque agent (les limites sont comptées par modèle).
# =====================================================================================================

# --- Groq (https://console.groq.com/keys)
# Clé partagée : utilisée par les agents qui n'ont pas de clé propre.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Agent 1 : Profilage (revue de chaque table, résumé).
GROQ_API_KEY_AGENT1=
# Agent 2 : Nettoyage (planificateur LLM : accepte ou refuse les outils proposés par les règles).
GROQ_API_KEY_AGENT2=
# Agent 4 : KPI (aide au mapping des colonnes, rédaction des constats ; chiffres vérifiés par le code).
GROQ_API_KEY_AGENT4=
# Agent 5 : Dashboard (seulement si BI_FLOW_LLM_PROVIDER=groq, voir plus bas).
GROQ_API_KEY_AGENT5=
# Agent 6 : Auditor / XAI (explications reformulées puis vérifiées contre les preuves).
GROQ_API_KEY_AGENT6=

# Agent 3 : ETL (raisonnement sur la table de faits et les dimensions, modèle gpt-oss).
GROQ_API_KEY_AGENT3=
# Modèle Groq de l'ETL (défaut : GROQ_MODEL).
ETL_GROQ_MODEL=openai/gpt-oss-120b

# Couper tous les appels LLM d'un coup (les agents travaillent alors avec leurs règles) : BI_FLOW_USE_LLM=false
BI_FLOW_USE_LLM=true

# --- Agent 4 : KPI (src/agents/semantic_kpi/).
# Le LLM est activé automatiquement dès que l'Agent 4 a une clé. KPI_USE_LLM=0 le coupe, 1 le force.
# KPI_GROQ_MODEL change le modèle Groq de l'Agent 4.
KPI_USE_LLM=
KPI_GROQ_MODEL=

# --- Agent 5 : tableau de bord, MODE IA (src/agents/dashboard/config.py), avec la clé GROQ_API_KEY_AGENT5.
# Avec un schéma en étoile (cas de Northwind), le rapport par rôle est déterministe : le planificateur IA est sauté.
# Si l'étape Dashboard échoue : BI_FLOW_MODE=deterministic et BI_FLOW_LLM_PROVIDER=mock.
BI_FLOW_MODE=ai_assisted
BI_FLOW_LLM_PROVIDER=groq
BI_FLOW_LLM_MODEL=openai/gpt-oss-120b
# Fichiers de diagnostic de l'Agent 5 (lignage, mesures DAX, critique, journal de retours...) : désactivés par défaut,
# tout est déjà dans dashboard_generation_report.json. true = les écrire aussi (débogage).
BI_FLOW_DEBUG_OUTPUTS=false

# --- Agent 6 : Auditor / XAI (src/agents/auditor/).
# auto (défaut) : Groq avec la clé de l'Agent 6 si elle existe, sinon Claude si ANTHROPIC_API_KEY existe, sinon aucun LLM.
# Autres valeurs : groq | anthropic | none | hf (modèle local). Chaque phrase du LLM est vérifiée contre les preuves ;
# sans clé ou en cas d'échec d'appel, l'Auditor garde les preuves seules.
AUDITOR_LLM_PROVIDER=groq
# Modèle Groq de l'Auditor (défaut : GROQ_MODEL).
AUDITOR_GROQ_MODEL=openai/gpt-oss-120b
# Seulement avec AUDITOR_LLM_PROVIDER=anthropic : clé API Anthropic (https://console.anthropic.com) et modèle.
ANTHROPIC_API_KEY=
AUDITOR_ANTHROPIC_MODEL=claude-sonnet-5-5
# auto = ChromaDB si installé (pip install -r src/agents/auditor/requirements_auditor.txt), sinon recherche lexicale.
AUDITOR_RETRIEVAL=auto
