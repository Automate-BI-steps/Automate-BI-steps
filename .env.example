# Copier ce fichier en .env puis renseigner les valeurs.

# Clé API Groq (https://console.groq.com/keys)
GROQ_API_KEY=votre_cle_groq_ici

# Optionnel : modèle Groq utilisé par les agents (défaut : openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# Optionnel : clé Ollama Cloud (https://ollama.com), utilisée par l'Agent 3 (ETL) pour le
# raisonnement sur la table de faits et les dimensions (src/agents/etl/). Sans clé ou sans
# réseau, l'agent bascule automatiquement sur une sélection déterministe (voir son propre code).
OLLAMA_API_KEY=f0c198d8c37d442b98ba6834adcf5bd2.Y6h7q7k6vtyP_o64sIytcHj1
