{
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "expressions": [
      {
        "name": "SourceFolder",
        "kind": "m",
        "expression": "\"C:\\Users\\omri\\Desktop\\bi-flow\\generated\\dashboard_generator.source\\\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      },
      {
        "name": "TradeData",
        "kind": "m",
        "expression": [
          "let",
          "    Source = Csv.Document(File.Contents(SourceFolder & \"FactTrade.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
          "    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
          "    Selected = Table.SelectColumns(PromotedHeaders, {\"Date\", \"Country\", \"Product\", \"Direction\", \"Value\"}),",
          "    Typed = Table.TransformColumnTypes(Selected, {{\"Date\", type date}, {\"Country\", type text}, {\"Product\", type text}, {\"Direction\", type text}, {\"Value\", type number}}, \"en-US\")",
          "in",
          "    Typed"
        ]
      }
    ],
    "tables": [
      {
        "name": "FactTrade",
        "columns": [
          {
            "name": "Date",
            "dataType": "dateTime",
            "sourceColumn": "Date"
          },
          {
            "name": "Country",
            "dataType": "string",
            "sourceColumn": "Country"
          },
          {
            "name": "Product",
            "dataType": "string",
            "sourceColumn": "Product"
          },
          {
            "name": "Direction",
            "dataType": "string",
            "sourceColumn": "Direction"
          },
          {
            "name": "Value",
            "dataType": "double",
            "sourceColumn": "Value"
          }
        ],
        "partitions": [
          {
            "name": "FactTrade",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = TradeData",
                "in",
                "    Source"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Imports",
            "expression": "CALCULATE(SUM(FactTrade[Value]), FactTrade[Direction] = \"Import\")"
          },
          {
            "name": "Total Exports",
            "expression": "CALCULATE(SUM(FactTrade[Value]), FactTrade[Direction] = \"Export\")"
          },
          {
            "name": "Trade Balance",
            "expression": "CALCULATE(SUM(FactTrade[Value]), FactTrade[Direction] = \"Export\") - CALCULATE(SUM(FactTrade[Value]), FactTrade[Direction] = \"Import\")"
          },
          {
            "name": "Transaction Count",
            "expression": "COUNTROWS(FactTrade)"
          }
        ]
      },
      {
        "name": "DimDate",
        "columns": [
          {
            "name": "Date",
            "dataType": "dateTime",
            "sourceColumn": "Date"
          }
        ],
        "partitions": [
          {
            "name": "DimDate",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Table.Distinct(Table.SelectColumns(TradeData, {\"Date\"}))",
                "in",
                "    Source"
              ]
            }
          }
        ]
      },
      {
        "name": "DimCountry",
        "columns": [
          {
            "name": "Country",
            "dataType": "string",
            "sourceColumn": "Country"
          }
        ],
        "partitions": [
          {
            "name": "DimCountry",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Table.Distinct(Table.SelectColumns(TradeData, {\"Country\"}))",
                "in",
                "    Source"
              ]
            }
          }
        ]
      },
      {
        "name": "DimProduct",
        "columns": [
          {
            "name": "Product",
            "dataType": "string",
            "sourceColumn": "Product"
          }
        ],
        "partitions": [
          {
            "name": "DimProduct",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Table.Distinct(Table.SelectColumns(TradeData, {\"Product\"}))",
                "in",
                "    Source"
              ]
            }
          }
        ]
      },
      {
        "name": "BusinessInsights",
        "columns": [
          {
            "name": "Kind",
            "dataType": "string",
            "sourceColumn": "Kind"
          },
          {
            "name": "Text",
            "dataType": "string",
            "sourceColumn": "Text"
          }
        ],
        "partitions": [
          {
            "name": "BusinessInsights",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(SourceFolder & \"BusinessInsights.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Selected = Table.SelectColumns(PromotedHeaders, {\"Kind\", \"Text\"}),",
                "    Typed = Table.TransformColumnTypes(Selected, {{\"Kind\", type text}, {\"Text\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "DataQuality",
        "columns": [
          {
            "name": "Check",
            "dataType": "string",
            "sourceColumn": "Check"
          },
          {
            "name": "Result",
            "dataType": "string",
            "sourceColumn": "Result"
          }
        ],
        "partitions": [
          {
            "name": "DataQuality",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(SourceFolder & \"DataQuality.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Selected = Table.SelectColumns(PromotedHeaders, {\"Check\", \"Result\"}),",
                "    Typed = Table.TransformColumnTypes(Selected, {{\"Check\", type text}, {\"Result\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "FactTradeDate",
        "fromTable": "FactTrade",
        "fromColumn": "Date",
        "toTable": "DimDate",
        "toColumn": "Date"
      },
      {
        "name": "FactTradeCountry",
        "fromTable": "FactTrade",
        "fromColumn": "Country",
        "toTable": "DimCountry",
        "toColumn": "Country"
      },
      {
        "name": "FactTradeProduct",
        "fromTable": "FactTrade",
        "fromColumn": "Product",
        "toTable": "DimProduct",
        "toColumn": "Product"
      }
    ]
  }
}