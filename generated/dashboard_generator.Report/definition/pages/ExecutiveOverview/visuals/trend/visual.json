              "queryRef": "DimDate.Date",
              "nativeQueryRef": "Date",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "FactTrade"
                    }
                  },
                  "Property": "Total Imports"
                }
              },
              "queryRef": "FactTrade.Total Imports",
              "nativeQueryRef": "Total Imports"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "FactTrade"
                    }
                  },
                  "Property": "Total Exports"
                }
              },
              "queryRef": "FactTrade.Total Exports",
              "nativeQueryRef": "Total Exports"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Import and Export Trends'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
