  {
    "id": "avg_lead_time",
    "nom": "Average Shipping Lead Time",
    "definition": "Délai moyen entre commande et expédition",
    "formule": "Moyenne (date d'expédition - date de commande)",
    "bo": "BO3",
    "pourquoi": "Performance logistique (BO3) : rapidité de traitement des commandes.",
    "dax": "AVERAGEX(VALUES(Fact_Trade[orderID]), DATEDIFF(CALCULATE(MIN(Fact_Trade[orderDate])), CALCULATE(MAX(Fact_Trade[shippedDate])), DAY))",
    "unite": "jours",
    "colonnes_sources": [
      "orderDate",
      "shippedDate",
      "orderID"
    ],
    "origine": {
      "orderDate": "orders",
      "shippedDate": "orders",
      "orderID": "order_details"
    }
  },
  {
    "id": "on_time_rate",
    "nom": "On-Time Shipping Rate",
    "definition": "Part des commandes expédiées à temps",
    "formule": "Commandes expédiées avant la date exigée / commandes expédiées",
    "bo": "BO3",
    "pourquoi": "Performance logistique (BO3) : respect de la date de livraison exigée.",
    "dax": "VAR expediees = FILTER(VALUES(Fact_Trade[orderID]), NOT ISBLANK(CALCULATE(MAX(Fact_Trade[shippedDate])))) RETURN DIVIDE(COUNTROWS(FILTER(expediees, CALCULATE(MAX(Fact_Trade[shippedDate])) <= CALCULATE(MAX(Fact_Trade[requiredDate])))), COUNTROWS(expediees)) * 100",
    "unite": "%",
    "colonnes_sources": [
      "shippedDate",
      "requiredDate",
      "orderID"
    ],
    "origine": {
      "shippedDate": "orders",
      "requiredDate": "orders",
      "orderID": "order_details"
    }
  }
