    }
  },
  {
    "id": "yoy_growth",
    "nom": "YoY Growth",
    "definition": "Croissance annuelle du CA (mêmes mois)",
    "formule": "(CA année N - CA année N-1) / CA année N-1, sur les mêmes mois",
    "bo": "BO3",
    "pourquoi": "KPI cité dans le rapport : montre l'évolution de la performance dans le temps (BO3).",
    "dax": "VAR cur = SUM(Fact_Trade[lineTotal]) VAR prev = CALCULATE(SUM(Fact_Trade[lineTotal]), SAMEPERIODLASTYEAR(Dim_Date[Date])) RETURN DIVIDE(cur - prev, prev)",
    "unite": "%",
    "colonnes_sources": [
      "lineTotal",
      "orderDate"
    ],
    "origine": {
      "lineTotal": "calculé : unitPrice × quantity × (1 − discount)",
      "orderDate": "orders"
    }
  },
  {
    "id": "top_countries",
    "nom": "Top Countries",
    "definition": "5 premiers pays et leur part du CA",
    "formule": "Somme par pays, du plus grand au plus petit",
    "bo": "BO3",
    "pourquoi": "Besoin de Leila (KPI pays fiables) : révèle les marchés clés et la dépendance géographique (BO3).",
    "dax": "DIVIDE(SUM(Fact_Trade[lineTotal]), CALCULATE(SUM(Fact_Trade[lineTotal]), ALL(Fact_Trade[country])))",
    "unite": "valeur / %",
    "colonnes_sources": [
      "lineTotal",
      "country"
    ],
    "origine": {
      "lineTotal": "calculé : unitPrice × quantity × (1 − discount)",
      "country": "customers"
    }
  },
  {
    "id": "top_products",
