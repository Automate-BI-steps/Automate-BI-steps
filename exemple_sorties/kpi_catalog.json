    "nom": "Average Order Value",
    "definition": "Panier moyen par commande",
    "formule": "Chiffre d'affaires / nombre de commandes",
    "bo": "BO3",
    "pourquoi": "Montre la valeur moyenne d'une vente (BO3).",
